<main id="exam" data-remaining-ms="3600000" data-answer-url="/exam/answer" data-status-url="/exam/status" data-event-url="/exam/event" data-monitor="on">
  <div class="exam-bar on-board">
    <p class="timer-box"><span class="visually-hidden">Time remaining</span><span id="timer" role="timer" data-level="normal">60:00</span></p>
    <span id="save-state" role="status" data-state="saved">✓ All answers saved</span>
    <button type="button" id="nav-toggle" aria-expanded="false" aria-controls="question-nav" hidden class="secondary">Questions</button>
    <div id="monitor-banner" class="banner banner-warn" role="alert" hidden>Your teacher has been notified.</div>
  </div>
  <p id="timer-announce" class="visually-hidden" aria-live="polite"></p>

  <noscript><p class="banner banner-danger">This exam needs JavaScript to save your answers.</p></noscript>
  <div id="time-up" class="banner banner-danger" role="alert" hidden>Time is up. Finishing your exam…</div>
  <div id="moved" class="banner banner-warn" role="alert" hidden>This attempt is no longer active on this device. <a href="/">Go to the start page</a></div>

  <div class="exam-layout">
    <nav id="question-nav" data-open="false" aria-label="Questions">
      <p id="answered-count">Answered 0 of 5</p>
      <ol class="nav-grid">
        <li><a class="bubble" href="#q1" data-answered="false">1</a></li>
        <li><a class="bubble" href="#q2" data-answered="false">2</a></li>
        <li><a class="bubble" href="#q3" data-answered="false">3</a></li>
        <li><a class="bubble" href="#q4" data-answered="false">4</a></li>
        <li><a class="bubble" href="#q5" data-answered="false">5</a></li>
        
      </ol>
    </nav>

    <div class="exam-questions">
      
      
      <section class="question" id="q1" data-question-id="3">
        <div class="question-head">
          <p class="eyebrow">Question 1 of 5</p>
          <span class="q-state" data-state="idle"></span>
        </div>
        <div class="question-body"><p>Question 3</p>
</div>
        <fieldset class="options">
          <legend class="visually-hidden">Answer for question 1</legend>
          
          <label class="option" for="o9">
            <input type="radio" name="q3" value="9" id="o9">
            <span class="bubble">A</span>
            <span class="option-body"><p>Option 3.3</p>
</span>
          </label>
          
          <label class="option" for="o8">
            <input type="radio" name="q3" value="8" id="o8">
            <span class="bubble">B</span>
            <span class="option-body"><p>Option 3.2</p>
</span>
          </label>
          
          <label class="option" for="o7">
            <input type="radio" name="q3" value="7" id="o7">
            <span class="bubble">C</span>
            <span class="option-body"><p>Option 3.1</p>
</span>
          </label>
          
        </fieldset>
      </section>
      
      <section class="question" id="q2" data-question-id="4">
        <div class="question-head">
          <p class="eyebrow">Question 2 of 5</p>
          <span class="q-state" data-state="idle"></span>
        </div>
        <div class="question-body"><p>Question 4</p>
</div>
        <fieldset class="options">
          <legend class="visually-hidden">Answer for question 2</legend>
          
          <label class="option" for="o11">
            <input type="radio" name="q4" value="11" id="o11">
            <span class="bubble">A</span>
            <span class="option-body"><p>Option 4.2</p>
</span>
          </label>
          
          <label class="option" for="o10">
            <input type="radio" name="q4" value="10" id="o10">
            <span class="bubble">B</span>
            <span class="option-body"><p>Option 4.1</p>
</span>
          </label>
          
          <label class="option" for="o12">
            <input type="radio" name="q4" value="12" id="o12">
            <span class="bubble">C</span>
            <span class="option-body"><p>Option 4.3</p>
</span>
          </label>
          
        </fieldset>
      </section>
      
      <section class="question" id="q3" data-question-id="5">
        <div class="question-head">
          <p class="eyebrow">Question 3 of 5</p>
          <span class="q-state" data-state="idle"></span>
        </div>
        <div class="question-body"><p>Question 5</p>
</div>
        <fieldset class="options">
          <legend class="visually-hidden">Answer for question 3</legend>
          
          <label class="option" for="o14">
            <input type="radio" name="q5" value="14" id="o14">
            <span class="bubble">A</span>
            <span class="option-body"><p>Option 5.2</p>
</span>
          </label>
          
          <label class="option" for="o15">
            <input type="radio" name="q5" value="15" id="o15">
            <span class="bubble">B</span>
            <span class="option-body"><p>Option 5.3</p>
</span>
          </label>
          
          <label class="option" for="o13">
            <input type="radio" name="q5" value="13" id="o13">
            <span class="bubble">C</span>
            <span class="option-body"><p>Option 5.1</p>
</span>
          </label>
          
        </fieldset>
      </section>
      
      <section class="question" id="q4" data-question-id="2">
        <div class="question-head">
          <p class="eyebrow">Question 4 of 5</p>
          <span class="q-state" data-state="idle"></span>
        </div>
        <div class="question-body"><p>Question 2</p>
</div>
        <fieldset class="options">
          <legend class="visually-hidden">Answer for question 4</legend>
          
          <label class="option" for="o6">
            <input type="radio" name="q2" value="6" id="o6">
            <span class="bubble">A</span>
            <span class="option-body"><p>Option 2.3</p>
</span>
          </label>
          
          <label class="option" for="o5">
            <input type="radio" name="q2" value="5" id="o5">
            <span class="bubble">B</span>
            <span class="option-body"><p>Option 2.2</p>
</span>
          </label>
          
          <label class="option" for="o4">
            <input type="radio" name="q2" value="4" id="o4">
            <span class="bubble">C</span>
            <span class="option-body"><p>Option 2.1</p>
</span>
          </label>
          
        </fieldset>
      </section>
      
      <section class="question" id="q5" data-question-id="1">
        <div class="question-head">
          <p class="eyebrow">Question 5 of 5</p>
          <span class="q-state" data-state="idle"></span>
        </div>
        <div class="question-body"><p>Question 1</p>
</div>
        <fieldset class="options">
          <legend class="visually-hidden">Answer for question 5</legend>
          
          <label class="option" for="o2">
            <input type="radio" name="q1" value="2" id="o2">
            <span class="bubble">A</span>
            <span class="option-body"><p>Option 1.2</p>
</span>
          </label>
          
          <label class="option" for="o1">
            <input type="radio" name="q1" value="1" id="o1">
            <span class="bubble">B</span>
            <span class="option-body"><p>Option 1.1</p>
</span>
          </label>
          
          <label class="option" for="o3">
            <input type="radio" name="q1" value="3" id="o3">
            <span class="bubble">C</span>
            <span class="option-body"><p>Option 1.3</p>
</span>
          </label>
          
        </fieldset>
      </section>
      

      <footer class="exam-footer">
        <p class="answered-summary">Answered 0 of 5</p>
        <form id="submit-form" method="post" action="/exam/submit">
          <button type="button" id="submit-open">Submit exam</button>
          <dialog id="submit-dialog" aria-labelledby="submit-title">
            <article>
              <h2 id="submit-title">Submit your exam?</h2>
              <p id="submit-summary"></p>
              <footer class="dialog-actions">
                <button type="button" id="submit-cancel" class="secondary">Keep working</button>
                <button type="submit" id="submit-confirm">Submit</button>
              </footer>
            </article>
          </dialog>
        </form>
      </footer>
    </div>
  </div>
</main>