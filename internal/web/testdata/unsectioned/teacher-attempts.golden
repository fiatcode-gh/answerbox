<main class="container admin attempts-page" data-exam-id="1">
  <p class="back"><a href="/admin/exams/1">← Exam questions, options review</a></p>
  <p class="eyebrow">Results</p>
  <h1>Exam questions, options review</h1>
  
  <div class="results-bar">
    <p class="counts">2 attempts — 1 in progress, 1 submitted, 0 timed out</p>
    <a id="export-csv" role="button" class="secondary" href="/admin/exams/1/attempts.csv">Export CSV</a>
  </div>
  <form id="name-filter" class="name-filter" method="get" action="/admin/exams/1/attempts" role="search">
    <label for="filter-name" class="visually-hidden">Filter by name</label>
    <input type="search" id="filter-name" name="name" value="" placeholder="Filter by name" maxlength="100" autocomplete="off">
    <input type="hidden" name="sort" value="started">
    <input type="hidden" name="dir" value="asc">
    <button type="submit" class="secondary">Filter</button>
    
  </form>
  
  <p class="zone-note">Date: <span id="attempts-date">Sat, 14 Nov 2026</span>. Times are shown in UTC.</p>
  <div class="overflow-auto">
    <table id="attempts">
      <thead>
        <tr>
          <th scope="col"><a href="?sort=name&amp;dir=asc" class="sort-link">Name</a></th>
          <th scope="col" aria-sort="ascending">Started <span aria-hidden="true">▲</span></th>
          <th scope="col">Finished</th>
          <th scope="col">Status</th>
          <th scope="col"><a href="?sort=score&amp;dir=desc" class="sort-link">Score</a></th>
          <th scope="col" class="wrap">Time left</th>
          <th scope="col" class="wrap">Resume code</th>
          <th scope="col">Flags</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        
        <tr data-attempt-id="1">
          <td>Ayu</td>
          <td class="numeric" title="2026-11-14 09:30">09:30</td>
          <td class="numeric" title="2026-11-14 09:40">09:40</td>
          <td><span class="badge badge-ok">Submitted</span></td>
          <td class="numeric">0 / 5</td>
          <td class="numeric">—</td>
          <td>—</td>
          <td class="numeric flags" data-flags="1">1</td>
          <td class="row-actions"><a href="/admin/exams/1/attempts/1">View</a> <a class="danger-link" href="/admin/exams/1/attempts/1/delete">Delete</a></td>
        </tr>
        
        <tr data-attempt-id="2">
          <td>Budi</td>
          <td class="numeric" title="2026-11-14 09:40">09:40</td>
          <td class="numeric">—</td>
          <td><span class="badge badge-warn">In progress</span></td>
          <td class="numeric">0 / 5</td>
          <td class="numeric">60:00</td>
          <td><code class="resume-code">VCV8-8BJ8</code></td>
          <td class="numeric flags" data-flags="0">0</td>
          <td class="row-actions"><a href="/admin/exams/1/attempts/2">View</a> <a class="danger-link" href="/admin/exams/1/attempts/2/delete">Delete</a></td>
        </tr>
        
      </tbody>
    </table>
  </div>
  
  
</main>