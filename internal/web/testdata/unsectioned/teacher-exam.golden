<main class="container admin exam-detail" data-exam-id="1">
  <p class="back"><a href="/admin/exams">← All exams</a></p>
  
  <div class="exam-head">
    <h1>Exam questions, options review</h1>
    <span class="badge badge-ok">Open</span>
  </div>
  
  <div class="exam-actions">
    
    
    <form method="post" action="/admin/exams/1/close">
      <input type="hidden" name="csrf_token" value="DNhydNZwhMqvDg02yEltt_71X-DhJXUKpgjV4g_8LRI">
      <button type="submit" class="secondary">Close</button>
    </form>
    
    <a role="button" class="secondary" href="/admin/exams/1/attempts">Results</a>
    <a id="history-link" role="button" class="secondary" href="/admin/exams/1/revisions">History</a>
    
    <a id="download-link" role="button" class="secondary" href="/admin/exams/1/download">Download</a>
    
    <form id="copy-form" method="post" action="/admin/exams/1/copy">
      <input type="hidden" name="csrf_token" value="DNhydNZwhMqvDg02yEltt_71X-DhJXUKpgjV4g_8LRI">
      <button type="submit" class="secondary">Copy exam</button>
    </form>
    
    
    <form id="archive-form" method="post" action="/admin/exams/1/archive">
      <input type="hidden" name="csrf_token" value="DNhydNZwhMqvDg02yEltt_71X-DhJXUKpgjV4g_8LRI">
      <button type="submit" class="secondary">Archive</button>
    </form>
    
  </div>
  

  <section class="join">
    <h2>Exam code</h2>
    <p id="exam-code" class="exam-code">GRFW9M</p>
    <p class="student-link">Student link: <a id="student-link" href="http://app.test/?code=GRFW9M">http://app.test/?code=GRFW9M</a></p>
    
  </section>

  
  <section class="schedule">
    <h2>Schedule</h2>
    <p id="schedule-times">No schedule. The exam follows the Open and Close buttons.</p>
    <form id="schedule-form" method="post" action="/admin/exams/1/schedule">
      <input type="hidden" name="csrf_token" value="DNhydNZwhMqvDg02yEltt_71X-DhJXUKpgjV4g_8LRI">
      <div class="schedule-fields">
        <label for="schedule-opens">Open time
          <input type="datetime-local" id="schedule-opens" name="opens_at" value="">
        </label>
        <label for="schedule-closes">Close time
          <input type="datetime-local" id="schedule-closes" name="closes_at" value="">
        </label>
      </div>
      <button type="submit">Save schedule</button>
    </form>
    <p class="zone-note">Times are shown in UTC. Without an open time the exam opens when you save; without a close time it stays open until you press Close. The close time stops new starts only. Open and Close remove the schedule.</p>
  </section>
  

  <dl class="settings">
    <dt>Length</dt>
    <dd>60 minutes</dd>
    <dt>Shuffle</dt>
    <dd>Questions and options shuffled</dd>
    <dt>Result shown to students</dt>
    <dd>Score and review</dd>
    <dt>Monitor</dt>
    <dd>On</dd>
    <dt>Questions</dt>
    <dd>5</dd>
  </dl>

  <section class="replace">
    <h2>Replace questions</h2>
    
    <p class="frozen-notice">This exam has attempts, so its questions are frozen.</p>
    
  </section>

  <h2>Preview</h2>
  
  
  <section class="preview-question" id="q1">
    <p class="eyebrow">Question 1</p>
    
    <div class="question-body"><p>Question 1</p>
</div>
    <ol class="preview-options">
      
      <li data-correct="true"><div class="option-body"><p>Option 1.1</p>
</div><span class="correct-mark">✓ Correct</span></li>
      
      <li data-correct="false"><div class="option-body"><p>Option 1.2</p>
</div></li>
      
      <li data-correct="false"><div class="option-body"><p>Option 1.3</p>
</div></li>
      
    </ol>

  </section>
  
  <section class="preview-question" id="q2">
    <p class="eyebrow">Question 2</p>
    
    <div class="question-body"><p>Question 2</p>
</div>
    <ol class="preview-options">
      
      <li data-correct="true"><div class="option-body"><p>Option 2.1</p>
</div><span class="correct-mark">✓ Correct</span></li>
      
      <li data-correct="false"><div class="option-body"><p>Option 2.2</p>
</div></li>
      
      <li data-correct="false"><div class="option-body"><p>Option 2.3</p>
</div></li>
      
    </ol>

  </section>
  
  <section class="preview-question" id="q3">
    <p class="eyebrow">Question 3</p>
    
    <div class="question-body"><p>Question 3</p>
</div>
    <ol class="preview-options">
      
      <li data-correct="true"><div class="option-body"><p>Option 3.1</p>
</div><span class="correct-mark">✓ Correct</span></li>
      
      <li data-correct="false"><div class="option-body"><p>Option 3.2</p>
</div></li>
      
      <li data-correct="false"><div class="option-body"><p>Option 3.3</p>
</div></li>
      
    </ol>

  </section>
  
  <section class="preview-question" id="q4">
    <p class="eyebrow">Question 4</p>
    
    <div class="question-body"><p>Question 4</p>
</div>
    <ol class="preview-options">
      
      <li data-correct="true"><div class="option-body"><p>Option 4.1</p>
</div><span class="correct-mark">✓ Correct</span></li>
      
      <li data-correct="false"><div class="option-body"><p>Option 4.2</p>
</div></li>
      
      <li data-correct="false"><div class="option-body"><p>Option 4.3</p>
</div></li>
      
    </ol>

  </section>
  
  <section class="preview-question" id="q5">
    <p class="eyebrow">Question 5</p>
    
    <div class="question-body"><p>Question 5</p>
</div>
    <ol class="preview-options">
      
      <li data-correct="true"><div class="option-body"><p>Option 5.1</p>
</div><span class="correct-mark">✓ Correct</span></li>
      
      <li data-correct="false"><div class="option-body"><p>Option 5.2</p>
</div></li>
      
      <li data-correct="false"><div class="option-body"><p>Option 5.3</p>
</div></li>
      
    </ol>

  </section>
  

</main>