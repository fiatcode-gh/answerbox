# Answerbox settings. Copy this file to .env and fill it in. The app reads only
# the process environment; README "Development" shows how to load the file.
# Optional keys stay commented out: an empty value in an env file overrides the
# default (for example the image's /data). Uncomment one only to set a value.

# OAuth client ID of the Google Cloud "Web application" client. Required.
ANSWERBOX_GOOGLE_CLIENT_ID=
# Client secret of that OAuth client. Required. Never commit it.
ANSWERBOX_GOOGLE_CLIENT_SECRET=
# Google account emails of the admins, comma-separated. Required, at least one. The first one receives the exams that existed before teacher accounts.
ANSWERBOX_ADMIN_EMAILS=
# Public address of the app without a path, for example https://exam.example.org. Required. The OAuth redirect URI is this address plus /admin/auth/callback.
ANSWERBOX_PUBLIC_URL=
# OpenID provider. Optional: default Google (https://accounts.google.com). Set it only for another provider or the local fake used in tests.
# ANSWERBOX_OIDC_ISSUER=
# Directory for the database and uploaded images. Optional: default ./data (the container image uses /data).
# ANSWERBOX_DATA_DIR=
# Address the HTTP server listens on. Optional: default :8080.
# ANSWERBOX_LISTEN_ADDR=
# Reverse proxies whose X-Forwarded-For is trusted, as comma-separated CIDRs or IPs. Optional: default none.
# ANSWERBOX_TRUSTED_PROXIES=
# IANA time zone for the times shown to teachers, the zone schedule times are typed and shown in, and the open time students read. Optional: default UTC.
# ANSWERBOX_TIME_ZONE=
